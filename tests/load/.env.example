# Параметры прогона. Скопируйте в .env и правьте, либо передавайте те же имена
# ключами scripts/run.ps1 -- он выставляет их в окружение перед compose.
#
#     cp .env.example .env

# ---------------------------------------------------------------- стенд ----

NGINX_VERSION=1.28.0

# Узлов nginx с модулем. Меняется на лету: docker compose up -d --scale edge=3
EDGES=1

# Воркеров на узел. Фиксированное число, а не auto: бюджет CPU надо
# контролировать, иначе один узел забирает все ядра у генератора.
EDGE_WORKERS=4

# off либо путь с форматом, например:
#   EDGE_ACCESS_LOG=/dev/shm/access.log load buffer=64k flush=1s
# Лог в stdout контейнера идёт через docker-демон на каждый запрос и сам
# становится узким местом.
EDGE_ACCESS_LOG=off

# warn -- штатный уровень стенда. На info модуль пишет строку на каждый
# сработавший дедлайн, и в сценариях с таймаутами это тысячи строк в секунду.
EDGE_ERROR_LOG_LEVEL=warn

# error -- обязательно под нагрузкой: на info инспектор логирует каждое
# сообщение. info включают только при разборе конкретного случая.
INSPECTOR_LOG=error

# Реплик инспектора. Одно имя и один subject, но queue group позволяет убрать
# инспектор из роли узкого места, не меняя конфигурацию модуля.
INSPECTORS=1

# ------------------------------------------------------------ политики ----

WAF_MAX_INFLIGHT=4096
WAF_DEADLINE=200ms
WAF_INSPECTOR_TIMEOUT=200ms
# Классы waf_exception фазы запроса: pass или deny. Неназванные классы
# (body, inspector) остаются на умолчании модуля -- deny.
WAF_ON_TIMEOUT=deny
WAF_ON_ABSENT=deny
WAF_ON_BUS_ERROR=deny
WAF_SCORE_DENY=100

# ---------------------------------------------------------- генератор ----

# haproxy:8080 -- через балансировщик; edge:8080 -- мимо него.
# Разница между профилями и есть цена балансировщика.
TARGET=http://haproxy:8080

SCENARIO=smoke
RATE=2000
DURATION=2m
WARMUP=30s

# Значение WAF_DEADLINE в миллисекундах: генератору оно нужно, чтобы вычислить
# ожидаемый код ответа для запросов с задержкой инспектора.
WAF_DEADLINE_MS=200

# ------------------------------------------------------ модель трафика ----

CORPUS_SEED=20260813
CORPUS_SIZE=20000

# mixed -- тела до 64 KB; large -- отдельный профиль на низкой интенсивности
BODY_PROFILE=mixed

# Доля контрольной ветки waf off. Обязана быть ненулевой: итоговое число
# прогона -- разница квантилей между ветками.
CONTROL_RATIO=0.10

# Доли запросов, вызывающих у инспектора конкретный вердикт. SCORE_RATIO делится
# между двумя ступенями счёта: ниже порога и на пороге. REDIRECT_RATIO -- вердикт
# redirect, то есть челлендж: из счёта он не следует, его присылает инспектор.
ATTACK_RATIO=0.05
SCORE_RATIO=0.05
REDIRECT_RATIO=0.01
SLOW_RATIO=0.02
DEBUG_RATIO=0.01

# Доля клиентов, обрывающих соединение во время ожидания вердикта
ABORT_RATIO=0

# Задержка инспектора для медленных запросов, мс: одна заведомо внутри
# дедлайна, вторая заведомо за ним
SLOW_DELAY_OK=50
SLOW_DELAY_TIMEOUT=400

# ------------------------------------------------------------- порты ----
#
# Наружу выходят только порты управления. Путь нагрузки внутри docker-сети.
#
# Номера смещены на 10000 относительно привычных, чтобы стенд поднимался рядом
# с окружением из deploy/, которое занимает 8080, 8081, 8404, 4222, 8222 и
# 6379. Одновременно они не нужны, но и выяснять это конфликтом портов посреди
# прогона -- плохой способ.

PORT_LB=18080
PORT_LB_STATS=18404
PORT_NATS_MON=18222
PORT_PROM=19090
PORT_GRAFANA=13000
